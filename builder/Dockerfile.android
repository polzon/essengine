FROM fedora:44

WORKDIR /root

ENV ANDROID_SDK_ROOT=/root/sdk
ENV ANDROID_NDK_VERSION=29.0.14206865
ENV ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/${ANDROID_NDK_VERSION}

RUN dnf -y install --setopt=install_weak_deps=False \
      bash binutils bzip2 curl file findutils gcc gcc-c++ gettext git \
      jq make nano patch pkgconfig python3-pip tar unzip which xz zip \
      zstd && \
    pip install scons==4.10.1 && \
    dnf clean all

RUN dnf -y install adoptium-temurin-java-repository ncurses-compat-libs && \
    dnf -y install --enablerepo=adoptium-temurin-java-repository temurin-17-jdk && \
    dnf clean all

RUN set -eux; \
    mkdir -p "${ANDROID_SDK_ROOT}"; \
    cd "${ANDROID_SDK_ROOT}"; \
    cmdline=commandlinetools-linux-14742923_latest.zip; \
    curl -fLO "https://dl.google.com/android/repository/${cmdline}"; \
    unzip -q "${cmdline}"; \
    rm -f "${cmdline}"; \
    yes | cmdline-tools/bin/sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" --licenses > /dev/null; \
    cmdline-tools/bin/sdkmanager --sdk_root="${ANDROID_SDK_ROOT}" \
      "ndk;${ANDROID_NDK_VERSION}" \
      'cmdline-tools;latest' \
      'build-tools;36.1.0' \
      'platforms;android-36' \
      'cmake;3.31.6'

CMD ["/bin/bash"]
