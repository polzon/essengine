{
  "common_args": "target=template_release production=yes",
  "targets": [
    {
      "name": "linux-x86_64",
      "runner": "ubuntu-24.04",
      "container": "ghcr.io/polzon/essengine-builder-linux:main",
      "platform": "linuxbsd",
      "arch": "x86_64",
      "profile": "",
      "args": "",
      "outputs": {
        "godot.linuxbsd.template_release.x86_64": "linux_release.x86_64"
      }
    },
    {
      "name": "linux-arm64",
      "runner": "ubuntu-24.04",
      "container": "ghcr.io/polzon/essengine-builder-linux:main",
      "platform": "linuxbsd",
      "arch": "arm64",
      "profile": "",
      "args": "",
      "outputs": {
        "godot.linuxbsd.template_release.arm64": "linux_release.arm64"
      }
    },
    {
      "name": "windows-x86_64",
      "runner": "ubuntu-24.04",
      "container": "ghcr.io/polzon/essengine-builder-windows:main",
      "platform": "windows",
      "arch": "x86_64",
      "profile": "",
      "args": "use_mingw=yes d3d12=no angle=no accesskit=no",
      "outputs": {
        "godot.windows.template_release.x86_64.exe": "windows_release_x86_64.exe",
        "godot.windows.template_release.x86_64.console.exe": "windows_release_x86_64_console.exe"
      }
    },
    {
      "name": "windows-arm64",
      "runner": "ubuntu-24.04",
      "container": "ghcr.io/polzon/essengine-builder-windows:main",
      "platform": "windows",
      "arch": "arm64",
      "profile": "",
      "args": "use_llvm=yes mingw_prefix=/root/llvm-mingw d3d12=no angle=no accesskit=no",
      "outputs": {
        "godot.windows.template_release.arm64.llvm.exe": "windows_release_arm64.exe",
        "godot.windows.template_release.arm64.llvm.console.exe": "windows_release_arm64_console.exe"
      }
    }
  ]
}
